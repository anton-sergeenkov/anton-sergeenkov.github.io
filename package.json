{
  "name": "anton-sergeenkov",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "gh-pages": "gh-pages -d out",
    "commit": "git add . && git commit -m \"Bash Script Commit\" && git push origin head",
    "create-nojekyll": "node ./node.js/nojekyll.js",
    "copy-cv": "node ./node.js/copy-cv.js",
    "deploy": "npm run build && npm run create-nojekyll && npm run copy-cv && npm run gh-pages && npm run commit",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dotenv": "^18.0.10",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sawyer-ui": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-prettier": "^5.5.7",
    "gh-pages": "^6.3.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3"
  }
}
